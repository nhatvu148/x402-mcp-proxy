# `target/` not `/target` — the leading slash anchors to the repo root, which
# is why examples/coinflip-server/target/ was never ignored: 2760 build
# artifacts got committed and .git reached 216 MB.
target/

# Never commit a wallet. This crate's whole job is holding one, and the
# natural thing to do is `solana-keygen new -o payer.json` right here.
payer.json
*.keypair.json
id.json

# stderr captures from manual runs
*.err

# Machine-specific: absolute paths, and it names where the wallet lives.
.mcp.json

# Loaded by Taskfile's `dotenv`. Holds personal wallet addresses — public
# on-chain, but no reason to tie them to this repo's history.
.env
.env.local

# Personal walkthrough notes — kept locally, deliberately not tracked.
scripts/claude-test-prompts.txt

# Where the transcriber writes when this proxy is exercised against it by hand.
archive/
